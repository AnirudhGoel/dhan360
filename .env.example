# Copy to backend/.env (or export in your shell) to override defaults.

# Where the local SQLite DB and any data are stored. Nothing leaves this directory.
DHAN360_DATA_DIR=./data

# Allowed CORS origins for the Vite dev server (comma-separated). Only used in development.
DHAN360_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
